---
import '../styles/global.css';
const { title, description = 'Sistema de venta y validación de entradas para eventos. Demo que corre 100% en el navegador.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  ['Inicio', base],
  ['Eventos', base + 'eventos/'],
  ['Vender', base + 'vender/'],
  ['Tickets', base + 'tickets/'],
  ['Validar', base + 'validar/'],
  ['Reportes', base + 'reportes/'],
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml">
</head>
<body data-base={base}>
  <header class="site">
    <div class="wrap">
      <a class="logo" href={base}>Entradas <span>Eventos</span></a>
      <nav>
        {nav.map(([t, h]) => <a href={h} aria-current={h === base ? (path === base ? 'page' : undefined) : (path.startsWith(h) ? 'page' : undefined)}>{t}</a>)}
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="site">
    <div class="wrap">
      Demo 100% en el navegador: los datos se guardan en tu dispositivo (localStorage). Sin servidor, sin base de datos.{' '}
      <a href="https://github.com/gusdv16/entrada-eventos">Código en GitHub</a>.
    </div>
  </footer>
</body>
</html>
